`timescale 1ns/1ps

module tb_mux;

  logic [31:0] a, b, c, d;
  logic [1:0]  sel;
  logic [31:0] muxOut;

  mux dut (
    .f(muxOut),
    .a(a),
    .b(b),
    .c(c),
    .d(d),
    .sel(sel)
  );

  initial begin
    $monitor("time=%0t | sel=%b | a=%h b=%h c=%h d=%h | muxOut=%h",
              $time, sel, a, b, c, d, muxOut);

    // valores fixos e distintos para identificar visualmente
    // qual entrada foi selecionada
    a = 32'hAAAA_AAAA;
    b = 32'hBBBB_BBBB;
    c = 32'hCCCC_CCCC;
    d = 32'hDDDD_DDDD;

    for (sel = 2'b00; sel != 2'b11; sel++) #10;
    #10 sel = 2'b11;   // garante que sel = 11 também seja testado
    #10 $stop;
  end

endmodule: tb_mux
